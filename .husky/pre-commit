#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Optimize any staged images under public/blog-images before commit
changed_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^public/blog-images/.+\.(png|jpg|jpeg|webp)$' || true)

if [ -n "$changed_files" ]; then
  echo "Optimizing images..."
  npm run optimize:images --silent
  # Re-add possibly modified files to the commit
  echo "$changed_files" | xargs git add -A --
fi

